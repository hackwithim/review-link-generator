# Server Port (default 5000 in dev, dynamic on Render/Railway/Heroku)
PORT=5000

# Admin Authentication (defaults to review_admin / WebWorks@Admin2026!)
ADMIN_USERNAME=review_admin
ADMIN_PASSWORD=WebWorks@Admin2026!
JWT_SECRET=webworks-super-secret-key-2026


# Optional MongoDB Connection String (e.g. MongoDB Atlas)
# If left empty, the application automatically uses the resilient local NoSQL document store with zero setup required.
MONGODB_URI=
MONGODB_DB_NAME=reviewflow

# Post-submission redirection destination
VITE_REDIRECT_URL=https://webworksstudios.com/

